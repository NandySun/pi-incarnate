{
  "name": "pi-incarnate",
  "version": "0.3.0",
  "description": "A character persona layer for Pi Agent",
  "author": "NandySun",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NandySun/pi-incarnate.git"
  },
  "homepage": "https://github.com/NandySun/pi-incarnate#readme",
  "bugs": {
    "url": "https://github.com/NandySun/pi-incarnate/issues"
  },
  "keywords": [
    "pi-package",
    "pi-agent",
    "pi-extension",
    "character",
    "persona",
    "roleplay"
  ],
  "files": [
    "CHANGELOG.md",
    "SECURITY.md",
    "characters",
    "evals",
    "extensions",
    "scripts/persona-eval.mjs",
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:companion": "node --test tests/companion-ui.integration.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "eval:persona": "node scripts/persona-eval.mjs",
    "verify": "npm run check && npm test",
    "release:check": "npm run verify && npm run test:package && npm pack --dry-run --ignore-scripts",
    "prepublishOnly": "npm run verify"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
